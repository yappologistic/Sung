#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=OFF -DSUNG_DIAGNOSTICS=OFF

# The test suite needs a session bus and generated fixtures; it is run from
# scripts/test.sh, not from a package build.
override_dh_auto_test:

execute_after_dh_auto_install:
	packaging/common/venv.sh debian/sung /usr

# Everything below keeps debhelper's hands off the bundled virtualenv. Its
# shared objects come from Python wheels and belong to no Debian package, its
# shebangs are already rewritten to the installed path, and dh_python3 would
# try to adopt it into the system interpreter's module path.
override_dh_shlibdeps:
	dh_shlibdeps -Xlib/sung/runtime

override_dh_strip:
	dh_strip -Xlib/sung/runtime

override_dh_dwz:

override_dh_python3:
